author={'t Hooft, Gerardus},
editor={Akil, Ali
and Bambi, Cosimo},
title={Alternative Theory for the Quantum Black Hole and the Temperature of Its Quantum Radiation},
bookTitle={The Black Hole Information Paradox: A Fifty-Year Journey},
year={2025},
publisher={Springer Nature Singapore},
address={Singapore},
pages={81--125},
abstract={A mechanism is found that explains how matter falling into the future event horizon of a black hole leaves information there, which it sends to the past event horizon, and there it determines how particles are emitted. This way information can be conserved. The mechanism is a calculable gravitational effect. We also show how it is avoided that the ``hidden region'' of the black hole gets involved, which has been standing out as a problem ever since Hawking found that particles must be emitted. The most striking consequence of our mechanism is that the radiation temperature is not what Hawking calculated, but twice that value. This is a direct consequence of the fact that what is usually handled as the hidden region, is not there.},
isbn={978-981-96-6170-1},
doi={10.1007/978-981-96-6170-1_4},
url={https://doi.org/10.1007/978-981-96-6170-1_4}
