\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces The CMB temperature power spectrum calculated for different effective fundamental mode spacings, characterized by $\Delta k = N$. Here, $N=1$ corresponds to the standard closed $\Lambda $CDM model. For this illustrative plot, we fix $\Omega _K$ and other cosmological parameters to be Planck best-fit values, and isolate the effect of the mode spacing. Larger values of $N$ (a sparser sampling in $k$-space) lead to more fluctuations on large angular scales.}}{30}{figure.caption.16}\protected@file@percent }
\newlabel{fig:CMB_diffN}{{3.1}{30}{The CMB temperature power spectrum calculated for different effective fundamental mode spacings, characterized by $\Delta k = N$. Here, $N=1$ corresponds to the standard closed $\Lambda $CDM model. For this illustrative plot, we fix $\Omega _K$ and other cosmological parameters to be Planck best-fit values, and isolate the effect of the mode spacing. Larger values of $N$ (a sparser sampling in $k$-space) lead to more fluctuations on large angular scales}{figure.caption.16}{}}
\newlabel{fig:CMB_diffN@cref}{{[figure][1][3]3.1}{[1][29][]30}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4.2}Post-processing \texttt  {Planck 2018} MCMC Samples}{30}{subsection.3.4.2}\protected@file@percent }
\newlabel{subsec:compare_planck}{{3.4.2}{30}{Post-processing \texttt {Planck 2018} MCMC Samples}{subsection.3.4.2}{}}
\newlabel{subsec:compare_planck@cref}{{[subsection][2][3,4]3.4.2}{[1][30][]30}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Numerical solutions for several allowed perturbation modes (modes 4--6 are shown to clarify the oscillatory behavior). As expected, the solutions are totally symmetric or antisymmetric at the future conformal boundary. The plot uses best-fit parameters corresponding to the $\Delta k=4$ case: $\Omega _m=0.435, \Omega _K=-0.038, h=0.564, \Omega _b=0.072$.}}{31}{figure.caption.17}\protected@file@percent }
\newlabel{fig:perturbations_allowedK}{{3.2}{31}{Numerical solutions for several allowed perturbation modes (modes 4--6 are shown to clarify the oscillatory behavior). As expected, the solutions are totally symmetric or antisymmetric at the future conformal boundary. The plot uses best-fit parameters corresponding to the $\Delta k=4$ case: $\Omega _m=0.435, \Omega _K=-0.038, h=0.564, \Omega _b=0.072$}{figure.caption.17}{}}
\newlabel{fig:perturbations_allowedK@cref}{{[figure][2][3]3.2}{[1][31][]31}}
