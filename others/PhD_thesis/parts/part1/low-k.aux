\newlabel{fig:geometry_solution}{{4.2a}{44}{Geometric interpretation of the solution method. The solution vector \( \Phi \) lies at the intersection of two distinct planes, spanned by \( |\varphi \big > \) and \( |\tilde {\varphi }\big > \). The projection matrices \( M \) and \( M^\top \) map vectors between these planes. The eigenvectors of \( MM^\top \) and \( M^\top M \) provide the valid coefficients for the solution in each respective basis}{figure.caption.21}{}}
\newlabel{fig:geometry_solution@cref}{{[subfigure][1][4,2]4.2a}{[1][43][]44}}
\newlabel{sub@fig:geometry_solution}{{a}{44}{Geometric interpretation of the solution method. The solution vector \( \Phi \) lies at the intersection of two distinct planes, spanned by \( |\varphi \big > \) and \( |\tilde {\varphi }\big > \). The projection matrices \( M \) and \( M^\top \) map vectors between these planes. The eigenvectors of \( MM^\top \) and \( M^\top M \) provide the valid coefficients for the solution in each respective basis}{figure.caption.21}{}}
\newlabel{sub@fig:geometry_solution@cref}{{[subfigure][1][4,2]4.2a}{[1][43][]44}}
\newlabel{fig:geometry_non_solution}{{4.2b}{44}{Geometric interpretation of the non-solution eigenvector \( \Psi \). Its magnitude is not conserved upon projection back and forth between the planes, resulting in an eigenvalue strictly less than $1$}{figure.caption.21}{}}
\newlabel{fig:geometry_non_solution@cref}{{[subfigure][2][4,2]4.2b}{[1][43][]44}}
\newlabel{sub@fig:geometry_non_solution}{{b}{44}{Geometric interpretation of the non-solution eigenvector \( \Psi \). Its magnitude is not conserved upon projection back and forth between the planes, resulting in an eigenvalue strictly less than $1$}{figure.caption.21}{}}
\newlabel{sub@fig:geometry_non_solution@cref}{{[subfigure][2][4,2]4.2b}{[1][43][]44}}
