\newlabel{fig:Slope_kc}{{2.4}{21}{The gradient of the phase of perturbations \(\theta \), as a function of \(\tilde \kappa \). The gradient constraint determines the preferred curvature values}{figure.caption.14}{}}
\newlabel{fig:Slope_kc@cref}{{[figure][4][2]2.4}{[1][20][]21}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.5}{\ignorespaces Comparison of predicted curvature values with \texttt  {Planck 2018} data (\texttt  {base\_omegak\_plikHM\_TTTEEE\_lowl\_lowE} from~\blx@tocontentsinit {7}\cite {2020A&A...641A...6P}). Predicted curvature values from \cref  {fig:Slope_kc} are shown.}}{21}{figure.caption.15}\protected@file@percent }
\newlabel{fig:Planck_kappa}{{2.5}{21}{Comparison of predicted curvature values with \texttt {Planck 2018} data (\texttt {base\_omegak\_plikHM\_TTTEEE\_lowl\_lowE} from~\cite {2020A&A...641A...6P}). Predicted curvature values from \cref {fig:Slope_kc} are shown}{figure.caption.15}{}}
\newlabel{fig:Planck_kappa@cref}{{[figure][5][2]2.5}{[1][20][]21}}
