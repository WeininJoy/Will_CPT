\newlabel{fig:theta_diffK}{{2.2a}{19}{Phase of perturbations \(\theta (\tilde {k},a\rightarrow \infty )\) with different curvature \(\tilde \kappa \). Larger \(\tilde \kappa \) results in a steeper curve. The value of \(\theta \) should be \(\frac {\pi }{2}n, n\in \mathbb {N}\), where the corresponding \(\tilde k\) are the allowed wave vectors forming a discrete spectrum}{figure.caption.12}{}}
\newlabel{fig:theta_diffK@cref}{{[subfigure][1][2,2]2.2a}{[1][18][]19}}
\newlabel{sub@fig:theta_diffK}{{a}{19}{Phase of perturbations \(\theta (\tilde {k},a\rightarrow \infty )\) with different curvature \(\tilde \kappa \). Larger \(\tilde \kappa \) results in a steeper curve. The value of \(\theta \) should be \(\frac {\pi }{2}n, n\in \mathbb {N}\), where the corresponding \(\tilde k\) are the allowed wave vectors forming a discrete spectrum}{figure.caption.12}{}}
\newlabel{sub@fig:theta_diffK@cref}{{[subfigure][1][2,2]2.2a}{[1][18][]19}}
\newlabel{fig:eta-log_a}{{2.2b}{19}{Evolution of scale factor $a$ with different curvature. When curvature increasing ($\Omega _{\kappa ,0}$ becomes more negative), it takes more time for $a$ to evolve to infinity. In other words, the age of the universe $\eta _\infty $ increase}{figure.caption.12}{}}
\newlabel{fig:eta-log_a@cref}{{[subfigure][2][2,2]2.2b}{[1][18][]19}}
\newlabel{sub@fig:eta-log_a}{{b}{19}{Evolution of scale factor $a$ with different curvature. When curvature increasing ($\Omega _{\kappa ,0}$ becomes more negative), it takes more time for $a$ to evolve to infinity. In other words, the age of the universe $\eta _\infty $ increase}{figure.caption.12}{}}
\newlabel{sub@fig:eta-log_a@cref}{{[subfigure][2][2,2]2.2b}{[1][18][]19}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Phase of perturbations $\theta $, in log-log plot. In the high-\(k\) mode, the gradient of \(\theta \) approximates a straight line, indicating that the discrete wave vectors are equally spaced. In a closed universe, these wave vectors must be integers, constraining the gradient $d\theta /dk_{\text  {int}}$ to be \(N\frac  {\pi }{2}\) or \(\frac  {1}{N}\frac  {\pi }{2}\) (where \(N\in \mathbb  {N}\)). Lines with gradient \(= \left [\frac  {1}{3}\frac  {\pi }{2}, \frac  {1}{2}\frac  {\pi }{2}, 1\frac  {\pi }{2}, 2\frac  {\pi }{2}, 3\frac  {\pi }{2}\right ]\) are plotted, corresponding to \(\tilde  {\kappa } = [0.113, 0.238, 0.672, 0.986, 0.999]\).}}{20}{figure.caption.13}\protected@file@percent }
\newlabel{fig:theta_kint}{{2.3}{20}{Phase of perturbations $\theta $, in log-log plot. In the high-\(k\) mode, the gradient of \(\theta \) approximates a straight line, indicating that the discrete wave vectors are equally spaced. In a closed universe, these wave vectors must be integers, constraining the gradient $d\theta /dk_{\text {int}}$ to be \(N\frac {\pi }{2}\) or \(\frac {1}{N}\frac {\pi }{2}\) (where \(N\in \mathbb {N}\)). Lines with gradient \(= \left [\frac {1}{3}\frac {\pi }{2}, \frac {1}{2}\frac {\pi }{2}, 1\frac {\pi }{2}, 2\frac {\pi }{2}, 3\frac {\pi }{2}\right ]\) are plotted, corresponding to \(\tilde {\kappa } = [0.113, 0.238, 0.672, 0.986, 0.999]\)}{figure.caption.13}{}}
\newlabel{fig:theta_kint@cref}{{[figure][3][2]2.3}{[1][20][]20}}
