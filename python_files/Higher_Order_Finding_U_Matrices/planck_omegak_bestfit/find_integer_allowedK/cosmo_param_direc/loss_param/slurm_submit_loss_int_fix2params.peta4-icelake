#!/bin/bash
#SBATCH -J fix2params_Optuna
#SBATCH -A DIRAC-DP192-CPU
#SBATCH -p icelake
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=36:00:00
#SBATCH --array=0-5%6
#SBATCH --mail-type=NONE
#SBATCH --mem=25G
#SBATCH -o slurm_fix2params_%A_%a.out
#SBATCH -e slurm_fix2params_%A_%a.err

. /etc/profile.d/modules.sh
module purge
module load rhel8/default-icl

workdir="/home/wnd22/rds/hpc-work/Will_CPT/Higher_Order_Finding_U_Matrices/find_integer_allowedK/cosmo_param_direc/loss_param"
cd "$workdir"
echo -e "Changed directory to $(pwd).\n"

source /home/wnd22/rds/hpc-work/Will_CPT/CMB_CLASS_integer/CLASS_int_env/bin/activate
which python

echo "JobID: $SLURM_JOB_ID"
echo "Array job ID: $SLURM_ARRAY_JOB_ID"
echo "Array task ID: $SLURM_ARRAY_TASK_ID"
echo "Time: $(date)"
echo "Running on node: $(hostname)"
echo "ntasks=$SLURM_NTASKS"
echo "cpus_per_task=$SLURM_CPUS_PER_TASK"

# Your own multiprocessing uses these cores.
export N_PROCESSES=$SLURM_CPUS_PER_TASK

# Keep BLAS/OpenMP single-threaded to avoid oversubscription.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

echo "N_PROCESSES=$N_PROCESSES"
echo "OMP_NUM_THREADS=$OMP_NUM_THREADS"

N_TRIALS=500

echo "Running pair index ${SLURM_ARRAY_TASK_ID} with target ${N_TRIALS} trials."

python calculate_integer_loss_func_fix2params_optuna.py \
    --pair-index "${SLURM_ARRAY_TASK_ID}" \
    --n-trials "${N_TRIALS}"

echo "Finished at $(date)"
deactivate
