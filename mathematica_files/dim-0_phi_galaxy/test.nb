Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nfw", "=", " ", 
     RowBox[{
      RowBox[{"rho0", "/", 
       RowBox[{"(", 
        RowBox[{"r", "/", "rs"}], ")"}]}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"r", "/", "rs"}]}], ")"}], "^", "2"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "''''"}], "[", "r", "]"}], "==", 
       RowBox[{
        RowBox[{"-", "nfw"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", "/", "r"}], ")"}], " ", 
         RowBox[{
          RowBox[{"y", "'''"}], "[", "r", "]"}]}]}]}], "}"}], ",", 
     RowBox[{"y", "[", "r", "]"}], ",", "r"}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
