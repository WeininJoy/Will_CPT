Notebook[{

Cell[CellGroupData[{
Cell["Minkowski spacetime", "Subtitle",
 CellChangeTimes->{{3.9500011704887342`*^9, 
  3.950001189124607*^9}},ExpressionUUID->"b95a759d-047e-49ef-94da-\
e508b7e9bd36"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "dependent", " ", "variables"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"phi", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"\[CurlyPhi]", "[", 
     RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"Scalar", " ", "field"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"phiVec", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[CurlyPhi]1", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
      RowBox[{"\[CurlyPhi]2", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
      RowBox[{"\[CurlyPhi]3", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
      RowBox[{"\[CurlyPhi]4", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}], "}"}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"4", "-", "vector"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"phiMat", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CurlyPhi]ij", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "4"}], "}"}]}], "]"}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"4", "\[Times]", "4", " ", "matrix"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tildePhi", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"\[Psi]", "[", 
     RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"Scalar", " ", "field"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tildePhiVec", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Psi]1", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
      RowBox[{"\[Psi]2", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
      RowBox[{"\[Psi]3", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
      RowBox[{"\[Psi]4", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}], "}"}], " ", 
    RowBox[{"(*", 
     RowBox[{"4", "-", "vector"}], "*)"}]}]}]}]], "Input",
 CellChangeTimes->{{3.950002858974659*^9, 3.950002860753058*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"2d0e293e-131d-42c7-8059-30617698e11d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Define", " ", "Levi"}], "-", 
    RowBox[{"Civita", " ", "symbol", " ", "in", " ", "4", "D"}]}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Eps4D", "=", 
     RowBox[{"LeviCivitaTensor", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", "4"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "derivatives"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "derivatives"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gradPhiVec", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"phiVec", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}]}], "]"}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[PartialD]", "i"}], " ", "\[Phi]j"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"gradPhiMat", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"phiMat", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}]}], "]"}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{"Gradient", " ", "of", " ", "phi_", 
     RowBox[{"{", "ij", "}"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gradTildePhi", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"tildePhi", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}]}], "]"}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[PartialD]", "k"}], " ", "\[Psi]_l"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Compute", " ", "contractions", " ", "with", " ", "Levi"}], "-", 
     
     RowBox[{"Civita", " ", "symbol"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"epsilonTerm1", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Eps4D", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "l", ",", "i", ",", "j"}], "]"}], "]"}], " ", 
        RowBox[{"gradTildePhi", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "l"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"epsilonTerm2", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Eps4D", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"phiMat", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "k"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "PDEs"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"eq1", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"phiVec", "[", 
           RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}]}], "]"}], ".", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "-", 
       RowBox[{"m", "*", 
        RowBox[{"phi", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}], "==", 
      "0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eq2", "=", 
     RowBox[{
      RowBox[{"gradPhiVec", "-", 
       RowBox[{"Total", "[", 
        RowBox[{"gradPhiMat", ",", 
         RowBox[{"{", "2", "}"}]}], "]"}], "-", 
       RowBox[{"m", "*", 
        RowBox[{"phiVec", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}], "==", 
      "0"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eq3", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", "gradPhiVec"}], "+", "epsilonTerm1", "-", 
       RowBox[{"m", " ", "phiMat"}]}], "==", "0"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"First", " ", "equation"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"eq4", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], " ", "epsilonTerm2"}], "+", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"tildePhi", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}]}], "]"}], "-", 
       RowBox[{"m", " ", "tildePhi"}]}], "==", "0"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Second", " ", "equation"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"eq5", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"phiVec", "[", 
           RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}]}], "]"}], ".", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "-", 
       RowBox[{"m", " ", 
        RowBox[{"phi", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}], "==", 
      "0"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Third", " ", "equation"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solve", " ", "numerically"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Set", " ", 
     RowBox[{"boundary", "/", "initial"}], " ", "conditions"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"initCond", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CurlyPhi]", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "0"}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"\[CurlyPhi]i", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "0"}], "]"}], "==", "0"}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"sol", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "eq1", ",", "eq2", ",", "eq3", ",", "eq4", ",", "eq5", ",", 
        "initCond"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "phi", ",", "phiVec", ",", "phiMat", ",", "tildePhi", ",", 
        "tildePhiVec"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0", ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "5"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.949997187557019*^9, 3.949997193354135*^9}, {
   3.94999838242446*^9, 3.949998395036366*^9}, {3.9499984329274054`*^9, 
   3.949998457265965*^9}, 3.949998688952696*^9, {3.9499988681209908`*^9, 
   3.949998902743903*^9}, {3.949998976071553*^9, 3.949998996899946*^9}, {
   3.9499990573039*^9, 3.949999064291094*^9}, {3.949999097849023*^9, 
   3.949999175625458*^9}, {3.9500003983381577`*^9, 3.950000436566119*^9}, {
   3.9500005068578863`*^9, 3.950000510281911*^9}, {3.950001164419602*^9, 
   3.950001168220746*^9}, 3.950001237406872*^9, {3.9500028559603767`*^9, 
   3.950002868292449*^9}},ExpressionUUID->"9fb6aaab-3bcf-4f48-b400-\
f6c41f82699a"]
}, Open  ]],

