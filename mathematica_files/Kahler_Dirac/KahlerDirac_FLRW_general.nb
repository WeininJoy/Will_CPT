         SuperscriptBox["a", "4"]}], ")"}], 
       RowBox[{
        RowBox[{"\[Phi]", "''"}], "[", "a", "]"}]}], "+", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{"rt", "+", 
         RowBox[{"2", 
          SuperscriptBox["a", "4"]}]}], ")"}], 
       RowBox[{
        RowBox[{"\[Phi]", "'"}], "[", "a", "]"}]}], "+", 
      RowBox[{"a", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["kt", "2"], "+", 
         RowBox[{
          SuperscriptBox["mt", "2"], " ", 
