Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Solve", " ", "the", " ", "equation", " ", "by", " ", "Taylor", " ", 
     "expansion", " ", "at", " ", "s"}], "=", "0"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"s", ",", "\[Psi]t", ",", "eq\[Psi]t", ",", "eqs"}], " ", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Define", " ", "the", " ", "power", " ", "series"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]t", "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nmax", "=", "10"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"psit", "[", "n", "]"}], " ", 
           RowBox[{"s", "^", "n"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", "nmax"}], "}"}]}], "]"}], "+", 
        RowBox[{
         RowBox[{"O", "[", "s", "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"nmax", "+", "1"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eq\[Psi]t", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", " ", 
           SuperscriptBox["m", "4"]}], "+", 
          RowBox[{
           SuperscriptBox["m", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", 
             RowBox[{"3", " ", 
              SuperscriptBox["k", "2"], " ", 
              SuperscriptBox["s", "2"]}], "-", 
             RowBox[{"6", " ", 
              SuperscriptBox["s", "4"]}]}], ")"}]}], "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["k", "2"], " ", 
           SuperscriptBox["s", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["s", "4"]}], ")"}]}]}], ")"}], "\[Psi]t"}], "+", 
       RowBox[{
        SuperscriptBox["s", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox["m", "2"]}], " ", 
              SuperscriptBox["s", "3"]}], "+", 
             RowBox[{
              SuperscriptBox["k", "2"], " ", 
              RowBox[{"(", 
               RowBox[{"s", "+", 
                SuperscriptBox["s", "5"]}], ")"}]}]}], ")"}], " ", 
           RowBox[{"Evaluate", "[", 
            RowBox[{"D", "[", 
             RowBox[{"\[Psi]t", ",", "s"}], "]"}], "]"}]}], "+", 
          RowBox[{
           SuperscriptBox["m", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["s", "4"]}], ")"}], " ", 
           RowBox[{"Evaluate", "[", 
            RowBox[{"D", "[", 
             RowBox[{"\[Psi]t", ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "2"}], "}"}]}], "]"}], "]"}]}]}], ")"}]}]}], 
      "==", "0"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Expand", " ", "the", " ", "differential", " ", "euqations", " ", "by", 
     " ", "power", " ", "series"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"eqs", "=", 
    RowBox[{"LogicalExpand", "[", 
     RowBox[{"eq\[Psi]t", "/.", 
      RowBox[{"{", 
       RowBox[{"m", "->", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", "/", "3"}], "]"}]}], "}"}]}], "]"}]}]}]}]], "Input",
