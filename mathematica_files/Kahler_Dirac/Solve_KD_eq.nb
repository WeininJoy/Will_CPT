Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Solve", " ", "the", " ", "equation", " ", "with", " ", "k"}], 
    "=", "0"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"equation", ",", "a", ",", "\[Psi]t"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"equation", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "4"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["a", "4"]}], ")"}], 
       RowBox[{
        RowBox[{"\[Psi]t", "''"}], "[", "a", "]"}]}], "+", 
      RowBox[{"2", "a", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["a", "6"], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["a", "4"]}], ")"}], 
          FractionBox[
           SuperscriptBox["k", "2"], 
           SuperscriptBox["m", "2"]]}]}], ")"}], 
       RowBox[{
        RowBox[{"\[Psi]t", "'"}], "[", "a", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", 
          FractionBox[
           SuperscriptBox["k", "2"], 
           SuperscriptBox["m", "2"]]}], "-", 
         RowBox[{"6", 
          SuperscriptBox["a", "2"]}], "+", 
         RowBox[{
          SuperscriptBox["k", "2"], 
          RowBox[{"(", 
           RowBox[{
            FractionBox["4", 
             SuperscriptBox["m", "2"]], "+", "3"}], ")"}], " ", 
          SuperscriptBox["a", "4"]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"3", 
             SuperscriptBox["m", "2"]}], "-", "2"}], ")"}], 
          SuperscriptBox["a", "6"]}]}], ")"}], " ", 
       RowBox[{"\[Psi]t", "[", "a", "]"}]}]}], "==", "0"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"solution", "=", " ", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"equation", "/.", 
         RowBox[{"{", 
          RowBox[{"k", "->", "0"}], "}"}]}], ",", " ", 
        RowBox[{
         RowBox[{"\[Psi]t", "[", "0", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Psi]t", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], 
      ",", 
      RowBox[{"\[Psi]t", "[", "a", "]"}], ",", "a"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
