Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Solve", " ", "the", " ", "equation", " ", "by", " ", "Taylor", " ", 
    "expansion"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"a", ",", "\[Psi]t"}], " ", "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Define", " ", "the", " ", "power", " ", "series"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]t", "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nmax", "=", "3"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"psit", "[", 
            RowBox[{"3", "+", 
             RowBox[{"4", "n"}]}], "]"}], " ", 
           RowBox[{"a", "^", 
            RowBox[{"(", 
             RowBox[{"3", "+", 
              RowBox[{"4", "n"}]}], ")"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", "nmax"}], "}"}]}], "]"}], "+", 
        RowBox[{
         RowBox[{"O", "[", "a", "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"3", "+", 
           RowBox[{"4", "nmax"}], "+", "1"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eq\[Psi]t", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["a", "4"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox["a", "4"]}], ")"}], 
        RowBox[{"Evaluate", "[", 
         RowBox[{"D", "[", 
          RowBox[{"\[Psi]t", ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "2"}], "}"}]}], "]"}], "]"}]}], "+", 
       RowBox[{"2", "a", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["a", "6"], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["a", "4"]}], ")"}], 
           FractionBox[
            SuperscriptBox["k", "2"], 
            SuperscriptBox["m", "2"]]}]}], ")"}], 
        RowBox[{"Evaluate", "[", 
         RowBox[{"D", "[", 
          RowBox[{"\[Psi]t", ",", "a"}], "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", 
           FractionBox[
            SuperscriptBox["k", "2"], 
            SuperscriptBox["m", "2"]]}], "-", 
          RowBox[{"6", 
           SuperscriptBox["a", "2"]}], "+", 
          RowBox[{
           SuperscriptBox["k", "2"], 
           RowBox[{"(", 
            RowBox[{
             FractionBox["4", 
              SuperscriptBox["m", "2"]], "+", "3"}], ")"}], " ", 
           SuperscriptBox["a", "4"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"3", 
              SuperscriptBox["m", "2"]}], "-", "2"}], ")"}], 
           SuperscriptBox["a", "6"]}]}], ")"}], " ", "\[Psi]t"}]}], "==", 
      "0"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Expand", " ", "the", " ", "differential", " ", "euqations", " ", "by", 
     " ", "power", " ", "series"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"eqs", "=", 
    RowBox[{"LogicalExpand", "[", 
     RowBox[{"eq\[Psi]t", "/.", 
      RowBox[{"{", 
       RowBox[{"k", "->", "0"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{"eqs", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"psit", "[", "7", "]"}], ",", 
        RowBox[{"psit", "[", "11", "]"}]}], "}"}]}], "]"}], 
    "]"}]}]}]], "Input",
