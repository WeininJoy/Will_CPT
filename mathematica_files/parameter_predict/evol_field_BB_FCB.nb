 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Phi", "[", "\[Eta]", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"BesselJ", "[", 
        RowBox[{
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox["m", "2"]}], "+", "\[Lambda]"}], "\[Lambda]"]], 
         ",", 
         RowBox[{
          RowBox[{"k", " ", "\[Eta]"}], "-", 
          RowBox[{"k", " ", "\[Eta]tot"}]}]}], "]"}], " ", 
       TemplateBox[{"1"},
        "C"]}], 
      RowBox[{
       RowBox[{"-", "\[Eta]"}], "+", "\[Eta]tot"}]], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"BesselY", "[", 
        RowBox[{
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"-", 
