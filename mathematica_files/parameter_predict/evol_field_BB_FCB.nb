Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Near", " ", "the", " ", 
    RowBox[{"Bang", ":", " ", 
     RowBox[{"a", "\\", "proto", " ", "\\", "eta"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"Phi", ",", " ", "eqPhi"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqPhi", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Phi", "''"}], "[", "\[Eta]", "]"}], "+", 
       RowBox[{"3", 
        RowBox[{
         RowBox[{
          RowBox[{"Phi", "'"}], "[", "\[Eta]", "]"}], "/", "\[Eta]"}]}], "+", 
       
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "^", "2"}], "+", 
          RowBox[{
           RowBox[{"m", "^", "2"}], 
           RowBox[{"\[Eta]", "^", "2"}]}]}], ")"}], 
        RowBox[{"Phi", "[", "\[Eta]", "]"}]}]}], "==", "0"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"DSolve", "[", 
    RowBox[{"eqPhi", ",", 
     RowBox[{"Phi", "[", "\[Eta]", "]"}], ",", "\[Eta]"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "m", " ", 
             SuperscriptBox["\[Eta]", "2"]}]], " ", 
           RowBox[{"HypergeometricU", "[", 
            RowBox[{
             RowBox[{"-", 
              FractionBox[
               RowBox[{"\[ImaginaryI]", " ", 
                SuperscriptBox["k", "2"]}], 
               RowBox[{"4", " ", "m"}]]}], ",", "0", ",", 
             RowBox[{
              RowBox[{"-", "\[ImaginaryI]"}], " ", "m", " ", 
              SuperscriptBox["\[Eta]", "2"]}]}], "]"}]}], 
          SuperscriptBox["\[Eta]", "2"]], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"k", "->", "1"}], ",", 
          RowBox[{"m", "->", "1"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"Abs", "[", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "m", " ", 
             SuperscriptBox["\[Eta]", "2"]}]], " ", 
           RowBox[{"LaguerreL", "[", 
            RowBox[{
             FractionBox[
              RowBox[{"\[ImaginaryI]", " ", 
               SuperscriptBox["k", "2"]}], 
              RowBox[{"4", " ", "m"}]], ",", 
             RowBox[{"-", "1"}], ",", 
             RowBox[{
              RowBox[{"-", "\[ImaginaryI]"}], " ", "m", " ", 
              SuperscriptBox["\[Eta]", "2"]}]}], "]"}]}], 
          SuperscriptBox["\[Eta]", "2"]], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"k", "->", "1"}], ",", 
          RowBox[{"m", "->", "1"}]}], "}"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", 
       RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", " ", "Orange"}], "}"}]}]}], "]"}]}]}]], "Input",\

