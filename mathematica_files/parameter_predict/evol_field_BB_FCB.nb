Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{" ", 
    RowBox[{
     RowBox[{"Near", " ", 
      RowBox[{"FCB", ":", " ", "a"}]}], "=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", "\[Lambda]", "]"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"\[Eta]tot", "-", "\[Eta]"}], ")"}]}]}], ")"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"Phi", ",", " ", "eqPhi", ",", "\[Lambda]", ",", "\[Eta]tot"}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", "\[Lambda]", "]"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"\[Eta]tot", "-", "\[Eta]"}], ")"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Lambda]", "->", "1"}], ",", 
        RowBox[{"\[Eta]tot", "->", "0"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"eqPhi", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Phi", "''"}], "[", "\[Eta]", "]"}], "-", 
       RowBox[{
        RowBox[{"3", "/", 
         RowBox[{"(", 
          RowBox[{"\[Eta]tot", "-", "\[Eta]"}], ")"}]}], 
        RowBox[{
         RowBox[{"Phi", "'"}], "[", "\[Eta]", "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "^", "2"}], "+", 
          RowBox[{
           RowBox[{
            RowBox[{"m", "^", "2"}], "/", "\[Lambda]"}], "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[Eta]tot", "-", "\[Eta]"}], ")"}], "^", "2"}]}]}], 
         ")"}], 
        RowBox[{"Phi", "[", "\[Eta]", "]"}]}]}], "==", "0"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", "eqPhi", "}"}], ",", 
     RowBox[{"Phi", "[", "\[Eta]", "]"}], ",", "\[Eta]"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         FractionBox[
          RowBox[{"BesselJ", "[", 
           RowBox[{
            SqrtBox[
             FractionBox[
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["m", "2"]}], "+", "\[Lambda]"}], "\[Lambda]"]],
             ",", 
            RowBox[{
             RowBox[{"k", " ", "\[Eta]"}], "-", 
             RowBox[{"k", " ", "\[Eta]tot"}]}]}], "]"}], 
          RowBox[{
           RowBox[{"-", "\[Eta]"}], "+", "\[Eta]tot"}]], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"k", "->", "1"}], ",", 
          RowBox[{"m", "->", "0.001"}], ",", 
          RowBox[{"\[Lambda]", "->", "1"}], ",", 
          RowBox[{"\[Eta]tot", "->", "0"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"Abs", "[", 
         FractionBox[
          RowBox[{"BesselY", "[", 
           RowBox[{
            SqrtBox[
             FractionBox[
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["m", "2"]}], "+", "\[Lambda]"}], "\[Lambda]"]],
             ",", 
            RowBox[{
             RowBox[{"k", " ", "\[Eta]"}], "-", 
             RowBox[{"k", " ", "\[Eta]tot"}]}]}], "]"}], 
          RowBox[{
           RowBox[{"-", "\[Eta]"}], "+", "\[Eta]tot"}]], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"k", "->", "1"}], ",", 
          RowBox[{"m", "->", "0.001"}], ",", 
          RowBox[{"\[Lambda]", "->", "1"}], ",", 
          RowBox[{"\[Eta]tot", "->", "0"}]}], "}"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Eta]", ",", 
        RowBox[{"\[Eta]tot", "-", "5"}], ",", 
        RowBox[{"\[Eta]tot", "+", "5"}]}], "}"}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Eta]tot", "->", "0"}], "}"}]}], ",", " ", 
